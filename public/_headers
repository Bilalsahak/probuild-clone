  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://code.tidio.co https://www.googletagmanager.com https://calendly.com; style-src 'self' 'unsafe-inline' https://calendly.com; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://formspree.io https://www.google-analytics.com https://calendly.com https://code.tidio.co https://*.tidiochat.com wss://socket.tidiochat.com; frame-src https://calendly.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io
/_next/static/*
