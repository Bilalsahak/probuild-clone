# Copy to .env.local for local overrides. None of these are secrets (NEXT_PUBLIC_*
# values are baked into the public site).

# Formspree endpoint (defaults to the one used on the live site)
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xnjeedlb

# Only for preview builds on GitHub Pages (project pages live under /<repo>):
# NEXT_PUBLIC_BASE_PATH=/masterfix-production-preview
# NEXT_PUBLIC_PREVIEW=1            # adds noindex + robots disallow

# Optional crew-feedback section. OFF by default. Read README "Crew feedback" first.
# NEXT_PUBLIC_SHOW_CREW_FEEDBACK=true

# Show photos held back for unverified provenance (see content/held-photos/README.md).
# Files must first be moved to public/images/ and added to src/content/photos.ts.
# NEXT_PUBLIC_SHOW_UNVERIFIED_PHOTOS=true
